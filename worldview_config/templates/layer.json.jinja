{
  "layers": {
    "{{ layer.id }}":
    {% set layer_data = {
        "id": layer.id,
        "title": layer.title,
        "subtitle": (layer.satellite | upper) ~ " / " ~ (layer.instrument | upper),
        "group": layer.group,
        "layergroup": layer.measurement,
        "description": layer.instrument ~ "/" ~ layer.satellite ~ "/" ~ layer.id,
        "disableSmartHandoff": true,
        "wrapadjacentdays": true
    } %}

    {% if layer.tags %}{% set _ = layer_data.update({"tags": layer.tags | join(' ')}) %}{% endif %}
    {% if layer.type is not none %}{% set _ = layer_data.update({"type": layer.type}) %}{% endif %}
    {% if layer.period is not none %}{% set _ = layer_data.update({"period": layer.period}) %}{% endif %}
    {% if layer.start_date is not none %}{% set _ = layer_data.update({"startDate": layer.start_date.strftime('%Y-%m-%dT%H:%M:%SZ')}) %}{% endif %}
    {% if layer.end_date is not none %}{% set _ = layer_data.update({"endDate": layer.end_date.strftime('%Y-%m-%dT%H:%M:%SZ')}) %}{% endif %}
    {% if layer.format is not none %}{% set _ = layer_data.update({"format": "image/" ~ layer.format}) %}{% endif %}
    {% if layer.ongoing is not none %}{% set _ = layer_data.update({"ongoing": layer.ongoing}) %}{% endif %}

    {% if layer.period == "subdaily" %}
       {% set temp_str = layer.temporal_start.strftime('%Y-%m-%dT%H:%M:%SZ') ~ "/" ~ layer.temporal_end.strftime('%Y-%m-%dT%H:%M:%SZ') ~ "/PT" ~ layer.date_interval ~ "M" %}
       {% set _ = layer_data.update({"temporal": temp_str}) %}
    {% endif %}

    {% if layer.colormap_id is not none %}
       {% set _ = layer_data.update({"palette": {"id": layer.colormap_id}}) %}
    {% endif %}

    {% if layer.projections is not none %}
       {% set _ = layer_data.update({"projections": layer.projections}) %}
    {% endif %}

    {{ layer_data | tojson(indent=6) }}
  }
}